{
  "manifest_version": 3,
  "name": "Import Halo Assignments",
  "description": "Import assignments from Halo into Notion",
  "version": "1.2.0",
  "icons": {
    "16": "/static/icon-16.png",
    "32": "/static/icon-32.png",
    "48": "/static/icon-48.png",
    "128": "/static/icon-128.png"
  },
  "host_permissions": [
    "https://halo.gcu.edu/*",
    "*://*.google.com/*",
    "http://localhost/*"
  ],
  "permissions": [
    "cookies",
    "identity",
    "storage",
    "tabs",
    "scripting"
  ],
  "minimum_chrome_version": "120",
  "action": {
    "default_icon": {
      "16": "/static/icon-16.png",
      "32": "/static/icon-32.png",
      "48": "/static/icon-48.png",
      "128": "/static/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Import Halo Assignments"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost:3000; object-src 'self';",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  }
}